{
  "id": "wellbore-pressure",
  "name": "井筒压力计算",
  "version": "1.2.0",
  "type": "app",
  "description": "井筒参数与分段井身结构编辑导入，联动结构示意和压力曲线，支持图表/数据表切换、工况对比与Excel导出。",
  "author": "UGSci Team",
  "entry": {
    "backend": "backend/main.py",
    "frontend": "ui/index.js"
  },
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.3.0"
  },
  "pack_exclude": [
    "src",
    "tests",
    "build.mjs"
  ],
  "meta": {
    "pawapp": {
      "icon": "⛽",
      "category": "research",
      "entry_page": "/apps/wellbore-pressure",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": false,
      "storage": false
    },
    "settings": []
  }
}
