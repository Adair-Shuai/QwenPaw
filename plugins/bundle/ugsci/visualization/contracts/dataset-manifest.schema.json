{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OilGas Visualization Dataset Manifest",
  "description": "Reusable reservoir, geological surface, well and surface-network datasets",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique dataset identifier"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name"
          },
          "n_vertices": {
            "type": "integer",
            "minimum": 0,
            "description": "Total vertex count (3 floats each)"
          },
          "n_cells": {
            "type": "integer",
            "minimum": 0,
            "description": "Active cell count"
          },
          "n_indices": {
            "type": "integer",
            "minimum": 0,
            "description": "Index count; geometry_primitive determines line pairs or triangle triples"
          },
          "grid_dims": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "[nx, ny, nz] grid dimensions"
          },
          "source": {
            "type": "string",
            "description": "Original data format"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "geometry_primitive": {"enum": ["lines", "triangles", "points"]},
              "scalar_association": {"enum": ["cell", "point"]},
              "vertices_per_cell": {"type": "integer", "minimum": 1},
              "indices_per_cell": {"type": "integer", "minimum": 1},
              "coordinate_system": {
                "type": "object",
                "properties": {
                  "axis_order": {"type": "string"},
                  "z_positive": {"enum": ["up", "down"]},
                  "source_z_positive": {"enum": ["up", "down"]},
                  "length_unit": {"type": ["string", "null"]},
                  "crs": {"type": ["string", "null"]}
                }
              },
              "topology": {
                "type": "object",
                "properties": {
                  "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "position"]}},
                  "edges": {"type": "array", "items": {"type": "object", "required": ["id", "from", "to", "cell_id"]}}
                },
                "required": ["nodes", "edges"]
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": {"type": "string"},
                "association": {"enum": ["cell", "point"]},
                "count": {"type": "integer", "minimum": 0},
                "unit": {"type": ["string", "null"]},
                "no_data": {"const": "nan"}
              },
              "required": ["association", "count"]
            }
          },
          "files": {
            "type": "object",
            "properties": {
              "positions": {"type": "string"},
              "indices": {"type": "string"},
              "cell_ids": {"type": "string"},
              "scalars": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          }
        },
        "required": ["id", "name", "n_vertices", "n_cells", "n_indices", "files"]
      }
    },
    "well_logs": {
      "type": "object",
      "properties": {
        "wells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "n_points": {"type": "integer"},
              "curves": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "description": "Property metadata (colormaps, ranges, units)"
    }
  },
  "required": ["version", "datasets"]
}
