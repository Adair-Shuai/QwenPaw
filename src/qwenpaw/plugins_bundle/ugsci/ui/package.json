{
  "name": "ugsci-plugin-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "description": "Frontend UI for the UGSci plugin — Expert Center, Capability Center, and Skill Center with agent data linkage",
  "scripts": {
    "check:dependencies": "node scripts/verify-dependencies.mjs",
    "test:dependencies": "node --test scripts/verify-dependencies.test.mjs",
    "test:compatibility": "node --test scripts/verify-dependencies.test.mjs scripts/well-runtime.test.mjs",
    "predev": "npm run check:dependencies",
    "prebuild:bootstrap": "npm run check:dependencies",
    "prebuild:viewer": "npm run check:dependencies && npm run test:compatibility",
    "dev": "vite build --watch",
    "build:bootstrap": "vite build",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "npm run build:bootstrap && npm run build:viewer",
    "typecheck": "npm run check:dependencies && tsc --noEmit"
  },
  "dependencies": {
    "@equinor/videx-3d": "3.4.3",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "comlink": "4.4.2",
    "html-to-image": "^1.11.13",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "zustand@^5": "5.0.15",
    "@react-three/drei": {
      "three-mesh-bvh": "0.8.3"
    },
    "stats-gl": {
      "three": "$three",
      "@types/three": "$@types/three"
    }
  }
}
