{
  "name": "ugsci-plugin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend UI for the UGSci plugin — Expert Center, Capability Center, and Skill Center with agent data linkage",
  "scripts": {
    "dev": "vite build --watch",
    "build:bootstrap": "vite build",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "npm run build:bootstrap && npm run build:viewer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": "^0.160.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
